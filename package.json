{
  "name": "project-dev-agent",
  "version": "0.11.1",
  "private": true,
  "description": "结合项目代码、业务背景和历史习惯辅助 Codex 开发，检查关联改动并保留项目经验。",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "project-dev-agent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "fixtures",
    "evals",
    "docs",
    "skills",
    "templates",
    "examples",
    "plugin.json",
    "README.md",
    "guide.html",
    "mcp.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && npm run build:plugin && node --test --test-concurrency=4 dist/tests/*.test.js",
    "test:integration": "npm run build && node --test --test-concurrency=4 dist/tests/*.integration.test.js",
    "sample:create": "npm run build && node dist/src/cli.js sample create",
    "check": "npm run typecheck && npm test",
    "build:plugin": "node scripts/build-plugin.mjs",
    "test:plugin": "npm run build:plugin && npm run build && node --test dist/tests/plugin*.test.js",
    "test:runtime": "node --test --test-concurrency=4 dist/tests/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
