{
  "name": "project-dev-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Codex project development workflow and local task evidence contracts",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "project-dev-agent": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "fixtures",
    "evals",
    "docs",
    "skills",
    "templates",
    "examples",
    "plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:integration": "npm run build && node --test dist/tests/*.integration.test.js",
    "sample:create": "npm run build && node dist/src/cli.js sample create",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
